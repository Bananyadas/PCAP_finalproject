{
    "configurations": [
        {
            "name": "Linux-target",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/**"
            ],
            "defines": ["_DEFAULT_SOURCE", "_POSIX_C_SOURCE=200809L", "_OPENMP"],
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerArgs": ["-fopenmp"]
        }
    ],
    "version": 4
}
